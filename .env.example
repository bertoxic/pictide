# Copy to .env, supply your own secrets, and never commit the populated file.
PORT=3000
LUMEN_HOST=127.0.0.1
LUMEN_PAYMENT_MODE=paystack
PAYSTACK_SECRET_KEY=
LUMEN_ADMIN_PASSWORD=
LUMEN_SIGNING_KEY=
# Set an HTTPS origin when hosting publicly, for example https://photos.example.com
PUBLIC_URL=
LUMEN_PLATFORM_FEE_BPS=1000
# Optional overrides: LUMEN_DATA_DIR, LUMEN_MEDIA_DIR

# Required MongoDB connection for the conversion service.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pictide

# Required for self-registration and recovery emails (SMTP STARTTLS).
LUMEN_SMTP_HOST=
LUMEN_SMTP_PORT=587
LUMEN_SMTP_USER=
LUMEN_SMTP_PASSWORD=
LUMEN_SMTP_FROM=

# Optional: public-facing previews only; originals and private submissions stay local.
IMGBB_API_KEY=
LUMEN_IMGBB_PREVIEWS=false

# Optional Cloudflare R2 image storage (set all four together)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional face search. Requires an ONNX Runtime build: go build -tags face_recognition .
# Embeddings remain in the private face_indexes collection, never public photo records.
PICTIDE_FACE_RECOGNITION=false
PICTIDE_FACE_RUNTIME=
PICTIDE_FACE_DETECTOR=
PICTIDE_FACE_RECOGNIZER=
PICTIDE_FACE_MODEL=sface-128-v1
PICTIDE_FACE_THRESHOLD=0.55
